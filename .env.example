# Anthropic API (camada de geração — RAG sobre o Ibovespa)
# Crie a chave em https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# HG Brasil Finance API (https://hgbrasil.com/docs/finance) — plano free, 400 req/dia
HG_BRASIL_API_KEY=

# Loop de cotação por ticker da HG Brasil (/finance/stock_price) — desligado
# por padrão: bloqueado no plano free, substituído pelo job brapi.dev
# (ver BRAPI_TOKEN abaixo). Mudar para true só se o plano HG Brasil mudar.
HG_BRASIL_STOCK_PRICE_ENABLED=false

# brapi.dev (https://brapi.dev/docs) — cotação por ticker da watchlist
# (config/watchlist.yaml), 1 requisição para a lista inteira. Opcional:
# PETR4/VALE3/ITUB4/MGLU3 respondem sem token; os demais tickers da
# watchlist exigem um token do plano free (gerar em brapi.dev/dashboard).
BRAPI_TOKEN=

# Postgres — local via Docker (docker-compose.yml na raiz do repo), único
# banco usado tanto em produção (ingestão/dashboard/chat) quanto em
# dev/testes. Migrado do Supabase em 2026-08-24 (conta atingiu o limite de
# projetos ativos). Suba com `docker compose up -d`, aplique as migrações
# com `uv run python scripts/apply_migrations.py`.
DATABASE_URL=postgresql://postgres:localdev@localhost:5433/postgres

# Comportamento do job HG Brasil quando o orçamento de requisições estiver insuficiente
# para cobrir a watchlist inteira: partial (default, recomendado) ou abort
HG_BRASIL_ON_INSUFFICIENT_BUDGET=partial

# Margem de segurança sobre o limite diário de 400 req (0.90 = usa no máx. 360/dia)
HG_BRASIL_SAFETY_MARGIN=0.90
