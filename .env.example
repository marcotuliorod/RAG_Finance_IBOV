# Anthropic API (camada de geração — RAG sobre o Ibovespa)
# Crie a chave em https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# HG Brasil Finance API (https://hgbrasil.com/docs/finance) — plano free, 400 req/dia
HG_BRASIL_API_KEY=

# Supabase (projeto: rag-finance-b3, região sa-east-1)
# URL do projeto: https://ufwbbifcichndjtqaarc.supabase.co
# A senha do banco NÃO é recuperável via MCP por segurança — gere/reset em
# Project Settings > Database > "Reset database password" (confirme a troca
# no painel antes de copiar) e cole na connection string do Session pooler
# (Project Settings > Database > Connection string > modo "Session pooler").
# Note o usuário qualificado com o project ref (postgres.<ref>), diferente
# da conexão direta (usuário simples "postgres").
SUPABASE_DB_URL=postgresql://postgres.ufwbbifcichndjtqaarc:[PASSWORD]@aws-1-sa-east-1.pooler.supabase.com:5432/postgres

# Postgres local (Docker) usado só para desenvolvimento/testes de integração
LOCAL_DEV_DB_URL=postgresql://postgres:localdev@localhost:5433/postgres

# Comportamento do job HG Brasil quando o orçamento de requisições estiver insuficiente
# para cobrir a watchlist inteira: partial (default, recomendado) ou abort
HG_BRASIL_ON_INSUFFICIENT_BUDGET=partial

# Margem de segurança sobre o limite diário de 400 req (0.90 = usa no máx. 360/dia)
HG_BRASIL_SAFETY_MARGIN=0.90
